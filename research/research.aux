\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Routing Accuracy and Deployment Efficiency} (binary label space, 270M backbone; primary configuration). Accuracy is measured against oracle labels; end-to-end accuracy resolves each decision to a candidate and checks answer correctness (\ref {sec:evaluation_metrics}). Pooled across both datasets (1,000 queries/seed), mean $\pm $ SD across 10 seeds. Always-Medium/Large serve every query with one fixed candidate (0~ms latency); their Acc vs.\ Oracle is that constant-label predictor's accuracy against oracle ground truth.}}{6}{table.caption.5}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:mainperf}{{1}{6}{\textbf {Routing Accuracy and Deployment Efficiency} (binary label space, 270M backbone; primary configuration). Accuracy is measured against oracle labels; end-to-end accuracy resolves each decision to a candidate and checks answer correctness (\ref {sec:evaluation_metrics}). Pooled across both datasets (1,000 queries/seed), mean $\pm $ SD across 10 seeds. Always-Medium/Large serve every query with one fixed candidate (0~ms latency); their Acc vs.\ Oracle is that constant-label predictor's accuracy against oracle ground truth}{table.caption.5}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {F1-Latency Frontier.} Routing Accuracy (y-axis) vs.\ per-query routing latency in ms, log scale (x-axis), for all eight distilled-router configurations plus the teacher, each in its own label space. Color: distillation variant. Shape: backbone size (270M circle, 1B square). Fill: label space (binary filled, three-label hollow). Error bars are $\pm 1$ SD across 10 seeds. Dashed/dotted lines mark the teacher's own oracle macro-F1 in binary (0.591, distinct from but close to the 0.592 accuracy figure in Table~\ref {tab:mainperf}) and three-label (0.380); since these are not on a comparable scale, each family is judged only against its own teacher anchor. Every distilled-router point beats its label-space's teacher on both latency and F1: all eight lie on a superior Pareto frontier.}}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:pareto}{{1}{7}{\textbf {F1-Latency Frontier.} Routing Accuracy (y-axis) vs.\ per-query routing latency in ms, log scale (x-axis), for all eight distilled-router configurations plus the teacher, each in its own label space. Color: distillation variant. Shape: backbone size (270M circle, 1B square). Fill: label space (binary filled, three-label hollow). Error bars are $\pm 1$ SD across 10 seeds. Dashed/dotted lines mark the teacher's own oracle macro-F1 in binary (0.591, distinct from but close to the 0.592 accuracy figure in Table~\ref {tab:mainperf}) and three-label (0.380); since these are not on a comparable scale, each family is judged only against its own teacher anchor. Every distilled-router point beats its label-space's teacher on both latency and F1: all eight lie on a superior Pareto frontier}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Cost-Quality Frontier} (binary label space, 270M backbone). Expected cost per query in milliseconds of compute, log scale (x-axis) vs.\ end-to-end accuracy (y-axis). Diamonds: fixed policies that serve every query with one candidate. Star: the teacher. Circles: DistillRouter, route-only (RO) and reasoning-plus-route (RR). Dotted line: the oracle ceiling (0.542), the accuracy of always picking the cheapest candidate that happens to answer correctly, an upper bound no real policy can exceed. Cost is measured in compute latency rather than dollar price (\ref {sec:datasets}).}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:cost-quality}{{2}{7}{\textbf {Cost-Quality Frontier} (binary label space, 270M backbone). Expected cost per query in milliseconds of compute, log scale (x-axis) vs.\ end-to-end accuracy (y-axis). Diamonds: fixed policies that serve every query with one candidate. Star: the teacher. Circles: DistillRouter, route-only (RO) and reasoning-plus-route (RR). Dotted line: the oracle ceiling (0.542), the accuracy of always picking the cheapest candidate that happens to answer correctly, an upper bound no real policy can exceed. Cost is measured in compute latency rather than dollar price (\ref {sec:datasets})}{figure.caption.7}{}}
