.claude
.venv/
__pycache__/
*.pyc
.DS_Store

# Regenerated by `python run.py prepare-data ...` / `label-data` / `oracle-label`;
# keep the folder structure (.gitkeep) but not the (re-downloadable / re-derivable) contents.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/teacher/*
!data/teacher/.gitkeep
data/oracle/*
!data/oracle/.gitkeep
data/student/*
!data/student/.gitkeep
data/unused/*
!data/unused/.gitkeep

# checkpoints/: single-seed exploratory scratch, fully superseded by the
# multi-seed runs*/ protocol below — nothing here is ever worth tracking.
checkpoints/

# --- runs*/, research_lambda_sweep/: trained-model artifacts -------------
# These directories hold BOTH the actual model weights (multi-GB per seed,
# regenerable via `make train-binary` / `make reproduce-table*` with the
# documented seed, see EXPERIMENTS.md) AND the small prediction/report
# files those weights produced (irreplaceable without re-running training).
# Rather than ignore whole checkpoint-*/ directories, ignore only the heavy
# filenames inside them — research_lambda_sweep/ in particular has no
# separate best/ folder, so its only provenance IS inside checkpoint-*/,
# and a directory-level ignore would silently discard it.
**/model.safetensors
**/*.bin
**/tokenizer.json
**/route_head.pt
**/optimizer.pt
**/scheduler.pt
**/rng_state.pth

# Verbose per-run training logs (multiseed/, runs_epoch20/, etc.) — content
# is already summarized in EXPERIMENTS.md's tables; regenerate by
# re-running the sweep if needed.
**/*.log

# Manual duplicate-copy archive (superseded by the pattern-based tracking
# above — predictions/reports now live in git in place, no separate copy
# needed). Ignored so it's never accidentally committed if recreated.
results_archive/
