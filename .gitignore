.claude
.venv/
__pycache__/
*.pyc
.DS_Store

# Regenerated by `python run.py prepare-data ...` / `label-data`; keep the
# folder structure (.gitkeep) but not the (re-downloadable / re-derivable) contents.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/teacher/*
!data/teacher/.gitkeep
data/oracle/*
!data/oracle/.gitkeep
data/student/*
!data/student/.gitkeep

# Trained checkpoints — regenerated by `python run.py train-student ...`, large binary weights.
checkpoints/
