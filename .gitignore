.claude
.venv/
__pycache__/
*.pyc
.DS_Store

# Regenerated by `python run.py prepare-data ...` / `label-data` / `oracle-label`;
# keep the folder structure (.gitkeep) but not the (re-downloadable / re-derivable) contents.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/teacher/*
!data/teacher/.gitkeep
data/oracle/*
!data/oracle/.gitkeep
data/student/*
!data/student/.gitkeep
data/unused/*
!data/unused/.gitkeep

# checkpoints/: single-seed exploratory scratch, fully superseded by the
# multi-seed runs*/ protocol below — nothing here is ever worth tracking.
checkpoints/

# runs*/, research_lambda_sweep/: trained-model artifacts (weights +
# predictions/reports) from experiments already run. Not needed for a new
# clone to run the pipeline — regenerate your own via `make reproduce-
# table3` etc. (see PIPELINE.md). The paper's actual reported numbers are
# permanently recorded in EXPERIMENTS.md / research.tex either way; these
# directories are raw provenance for independently re-auditing a specific
# number, not something the pipeline itself depends on. Kept on local
# disk, just not tracked in git.
runs/
runs_1b/
runs_binary/
runs_binary_1b/
runs_epoch20/
runs_epoch20_binary_10seed/
research_lambda_sweep/

# Verbose per-run training logs — content is already summarized in
# EXPERIMENTS.md's tables.
**/*.log

# Manual duplicate-copy archive, superseded by the above.
results_archive/
